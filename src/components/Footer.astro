---
import {
    GitHubLogoIcon,
    LinkedInLogoIcon,
    TwitterLogoIcon,
} from "@radix-ui/react-icons";
import SpotifyStatus from "@/components/SpotifyStatus";
---

<footer class="mt-auto flex flex-col gap-3 rounded-xl bg-indigo-50/90 px-2 py-4 shadow-sm backdrop-blur-sm sm:px-6 sm:py-5 md:pb-2">
    <div class="min-w-0 w-full pl-2">
        <SpotifyStatus client:load />
    </div>
    <div class="flex w-full flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-0">
        <nav aria-label="Social links" class="flex items-center">
            <a
                href="https://github.com/Sym521"
                aria-label="GitHub"
                class="flex size-10 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:text-zinc-900"
            >
                <GitHubLogoIcon width={24} height={24} />
            </a>
            <a
                href="https://x.com/esulikesbread"
                aria-label="X"
                class="flex size-10 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:text-sky-500"
            >
                <TwitterLogoIcon width={24} height={24} />
            </a>
            <a
                href="https://www.linkedin.com/in/hiroki-seyama/"
                aria-label="LinkedIn"
                class="flex size-10 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:text-blue-600"
            >
                <LinkedInLogoIcon width={24} height={24} />
            </a>
        </nav>
        <p class="pl-2 text-sm text-zinc-500 md:pl-0">
            ©{new Date().getFullYear()} gemi21.com
        </p>
    </div>
</footer>
