{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gemi21dotcom",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "gemi21.com",
      "custom_domain": true
    }
  ]
}
